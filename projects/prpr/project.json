      "title": "Walk the list",
      "startMs": 5695,
      "narration": "Arrow through them."
    },
    {
      "title": "The detail pane",
      "startMs": 7433,
      "narration": "The detail pane shows the branch, the diff stat and the reviewers."
    },
    {
      "title": "Filter down to one repository",
      "startMs": 11336,
      "narration": "Filtering searches titles, repositories, authors and labels at once."
    },
    {
      "title": "Tabs",
      "startMs": 16844,
      "narration": "Four tabs — everything, yours, awaiting your review, and drafts."
    },
    {
      "title": "Wait for the refresh that finds #127 merged",
