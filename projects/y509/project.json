      "startMs": 3864,
      "narration": ""
    },
    {
      "title": "Switch to details pane and browse tabs",
      "startMs": 5409,
      "narration": "Subject, issuer, validity, SANs — tab by tab."
    },
    {
      "title": "Search",
      "startMs": 10249,
      "narration": "Search jumps straight to a certificate."
    },
    {
      "title": "Filter",
      "startMs": 13116,
