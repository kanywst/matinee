      "narration": "Yank copies a cert as PEM."
    },
    {
      "title": "Export via huh form",
      "startMs": 20722,
      "narration": "Export writes it out in the format you pick."
    },
    {
      "title": "Help",
      "startMs": 25724,
      "narration": "And every key is listed in the help."
    }
  ],
