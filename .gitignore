
__pycache__/
.cache/
.DS_Store
*.pyc
# Generated assets. Rebuilt by `make video`; too big and too regenerable to
# track. project.json is checked in -- it is the contract, not an artifact.
node_modules/
out/
public/projects/*/broll.mp4
public/projects/*/narration.wav
public/projects/*/terminal.mp4
hello-props.json

# The hello example is the exception: its recording and narration are ~700KB
# together, and checking them in is what lets a bare clone render something.
!public/projects/hello/terminal.mp4
!public/projects/hello/narration.wav
